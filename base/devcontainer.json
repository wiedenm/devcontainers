{
  "name": "claude-code-base",
  // Built by build-images.sh from images/base.
  "image": "claude-code-base:latest",
  "remoteUser": "vscode",
  "mounts": [
    // Claude config, skills, etc.
    "source=${localEnv:HOME}/.claude,target=/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/vscode/.claude.json,type=bind,consistency=cached",
    // Include files symlinked from the .claude directory above.
    "source=${localEnv:HOME}/dev/claude-config,target=${localEnv:HOME}/dev/claude-config,type=bind,consistency=cached",
    // Hide the credentials, which are passed in as env vars instead (see runArgs).
    "type=tmpfs,target=${localEnv:HOME}/dev/claude-config/.credentials",
    // Add access to all git repos. Note that the git repo from which the dev container is launched will be mounted
    // twice in the container, once as the workspace folder and once among the git repos, but that shouldn't be a
    // problem.
    "source=${localEnv:HOME}/git,target=/workspaces/git,type=bind,consistency=cached",
    // Add global .gitconfig and .gitignore. The config is mounted to a path not recognized by git, as we need to make
    // some container-specific additions to (a copy of) it, see postStartCommand below. The .gitignore is assumed to be
    // referenced from .gitconfig using a relative path.
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig-host,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.gitignore,target=/home/vscode/.gitignore,type=bind,consistency=cached,readonly",
    // Pre-built Linux binaries shared across containers.
    "source=${localEnv:HOME}/dev/devcontainers/bin,target=/opt/host-bin,type=bind,consistency=cached",
    // Claude Code's native install, shared by all containers so that one auto-update reaches all of them.
    "source=claude-code,target=/opt/claude-code,type=volume"
  ],
  "remoteEnv": {
    // Add Claude Code and the pre-built Linux binaries to the container's PATH.
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}:/opt/host-bin",
    // The knime-build-system-mcp plugin reads the Dependency Track key under a different name.
    "DTRACK_API_KEY": "${containerEnv:DT_API_KEY}"
  },
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/vscode/.claude",
    // Rather than CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC, which also turns off auto-updates.
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    // Advertise truecolor so Claude renders full-color themes instead of falling back to 8-color mode.
    "COLORTERM": "truecolor",
    // Config for the KNIME Hub MCP.
    "KNIME_HUB_MCP_HUBS_FILE": "${localEnv:HOME}/dev/claude-config/mcp/config/knime-hubclient-hubs.yaml"
  },
  "runArgs": [
    // On macOS, Claude stores its credentials in the keychain rather than ~/.claude/.credentials.json. To avoid fiddling
    // with the keychain, create a long-lived OAuth token using `claude setup-token` on the host and make it available as
    // `CLAUDE_CODE_OAUTH_TOKEN` in the container, which Claude recognizes automatically.
    "--env-file",
    "${localEnv:HOME}/dev/claude-config/.credentials/claude-code.env",
    // Read-only access to GitHub (`GITHUB_TOKEN`)
    "--env-file",
    "${localEnv:HOME}/dev/claude-config/.credentials/github.env",
    // Access to Jira.
    "--env-file",
    "${localEnv:HOME}/dev/claude-config/.credentials/jira.env",
    // Access to OpenSearch.
    "--env-file",
    "${localEnv:HOME}/dev/claude-config/.credentials/opensearch.env",
    // Access to self-hosted Grafana (hubdev, hubprod).
    "--env-file",
    "${localEnv:HOME}/dev/claude-config/.credentials/grafana.env",
    // Access to Dependency Track.
    "--env-file",
    "${localEnv:HOME}/dev/claude-config/.credentials/dependency-track.env",
    // Access to Jenkins.
    "--env-file",
    "${localEnv:HOME}/dev/claude-config/.credentials/jenkins.env",
    // Access to KNIME Hub.
    "--env-file",
    "${localEnv:HOME}/dev/claude-config/.credentials/knime-hub.env"
  ],
  // Install Claude Code into the shared volume, unless an earlier container did.
  // Keep pixi environments out of project folders shared with the macOS host, and prebuild the environment of the
  // knime-build-system-mcp plugin, which may take longer on first start than Claude Code waits for the MCP server.
  "postCreateCommand": "[ -x ~/.local/bin/claude ] || curl -fsSL https://claude.ai/install.sh | bash; pixi config set --global detached-environments true; for m in /vscode/.claude/plugins/cache/dev-tools/knime-build-system-mcp/*/pyproject.toml; do [ ! -f \"$m\" ] || pixi install --frozen --manifest-path \"$m\" || echo \"pixi install failed for $m\" >&2; done",
  // Copy over the host's git config as template. Modify it to make sure git uses the access token defined above, by
  // replacing any use of SSH inside the container by HTTPS to make sure token auth works.
  "postStartCommand": "cp ~/.gitconfig-host ~/.gitconfig && { git config --global --remove-section url.\"ssh://git@github.com\" || true; } && git config --global credential.helper '!f() { echo username=x-access-token; echo password=$GITHUB_TOKEN; }; f' && git config --global url.\"https://github.com/\".insteadOf \"git@github.com:\""
}
