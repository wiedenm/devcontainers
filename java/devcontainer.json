{
  "name": "claude-code-java",
  // Java 21
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "remoteUser": "vscode",
  "features": {
    // Claude (+ Node dependency)
    "ghcr.io/devcontainers/features/node:latest": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:latest": {},
    // Git LFS
    "ghcr.io/devcontainers/features/git-lfs:latest": {},
    // Maven
    "ghcr.io/devcontainers/features/java:latest": {
      // Only include Maven here, Java is already part of the base image.
      "version": "none",
      "installMaven": "true",
      // Match version on host for consistency.
      "mavenVersion": "3.9.7"
    },
    // Docker-in-Docker (for integration tests)
    "ghcr.io/devcontainers/features/docker-in-docker:latest": {
      // `"moby": true` is the default but not supported on Debian Trixie, which
      // is what mcr.microsoft.com/devcontainers/java:21 currently ships on.
      "moby": false
    },
    // AWS CLI (for pulling images for integration tests)
    "ghcr.io/devcontainers/features/aws-cli:latest": {
      // Match version on host for consistency.
      "version": "2.23.9"
    },
    // GitHub CLI
    "ghcr.io/devcontainers/features/github-cli:latest": {}
  },
  "mounts": [
    // Claude config, skills, etc.
    "source=${localEnv:HOME}/.claude,target=/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/vscode/.claude.json,type=bind,consistency=cached",
    // Include files symlinked from the .claude directory above.
    "source=${localEnv:HOME}/dev/claude-config,target=${localEnv:HOME}/dev/claude-config,type=bind,consistency=cached",
    // Add access to all git repos. Note that the git repo from which the dev container is launched will be mounted
    // twice in the container, once as the workspace folder and once among the git repos, but that shouldn't be a
    // problem.
    "source=${localEnv:HOME}/git,target=/workspaces/git,type=bind,consistency=cached",
    // Add global .gitconfig and .gitignore. The config is mounted to a path not recognized by git, as we need to make
    // some container-specific additions to (a copy of) it, see postStartCommand below. The .gitignore is assumed to be
    // referenced from .gitconfig using a relative path.
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig-host,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.gitignore,target=/home/vscode/.gitignore,type=bind,consistency=cached,readonly",
    // Include known hosts to avoid "The authenticity of host 'github.com [...]' can't be established." when Git LFS
    // uses git via SSH.
    "source=${localEnv:HOME}/.ssh/known_hosts,target=/home/vscode/.ssh/known_hosts,type=bind,consistency=cached,readonly",
    // Maven config and cache
    // TODO: Writing to .m2 concurrently is not safe. Is there a way to mount this read-only (i.e. does Maven support
    // read-only caches)?
    "source=${localEnv:HOME}/.m2,target=/home/vscode/.m2,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/vscode/.claude",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    // Advertise truecolor so Claude renders full-color themes instead of falling back to 8-color mode.
    "COLORTERM": "truecolor"
  },
  "runArgs": [
    // On macOS, Claude stores its credentials in the keychain rather than ~/.claude/.credentials.json. To avoid fiddling
    // with the keychain, create a long-lived OAuth token using `claude setup-token` on the host and make it available as
    // `CLAUDE_CODE_OAUTH_TOKEN` in the container, which Claude recognizes automatically.
    "--env-file",
    "${localEnv:HOME}/dev/claude-config/.credentials/claude_code.env",
    // Read-only access to GitHub (`GITHUB_TOKEN`)
    "--env-file",
    "${localEnv:HOME}/dev/claude-config/.credentials/github.env",
    // Read-only access to AWS ECR (for pulling images for integration tests).
    "--env-file",
    "${localEnv:HOME}/dev/claude-config/.credentials/aws_ecr.env"
  ],
  // Copy over the host's git config as template. Modify it to make sure git uses the access token defined above, by
  // replacing any use of SSH inside the container by HTTPS to make sure token auth works.
  "postStartCommand": "cp ~/.gitconfig-host ~/.gitconfig && { git config --global --remove-section url.\"ssh://git@github.com\" || true; } && git config --global credential.helper '!f() { echo username=x-access-token; echo password=$GITHUB_TOKEN; }; f' && git config --global url.\"https://github.com/\".insteadOf \"git@github.com:\""
}
